pipeline { agent any tools { jdk 'JDK17' maven 'Maven' } environment { SONAR_HOST_URL = 'http://localhost:9000' } stages { stage('Clone repo') { steps { git url: 'https://github.com/your-username/your-repo.git' } } stage('Build') { steps { sh 'mvn clean compile' } } stage('Unit Tests') { steps { sh 'mvn test' } } stage('Package') { steps { sh 'mvn package' } } stage('SonarQube Analysis') { environment { SONAR_SCANNER_OPTS = '-Xmx512m' } steps { withSonarQubeEnv('SonarLocal') { sh "mvn sonar:sonar -Dsonar.projectKey=my-project" } } } } }
